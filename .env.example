# Copy to `.env` and fill in real values. Never commit `.env`.
# See docs/SECURITY-AUDIT.md before open-sourcing this repo.

# Client (bundled via EXPO_PUBLIC_* — use anon/publishable key only)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_APP_SECRET=
EXPO_PUBLIC_VOTE_BASE_URL=

# Maps (app.config.js — platform-specific or shared fallback)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Local maintenance scripts only — never in the mobile app or git
# SUPABASE_SERVICE_ROLE_KEY=
